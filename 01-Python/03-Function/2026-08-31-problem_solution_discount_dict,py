# ==============================================================
# ■ 문제 요약
# 공백으로 구분된 key=value 형태의 문자열(예: a=100 b=200)을 입력받아 딕셔너리로 저장한 후,
# 가변(Mutable) 객체 특성을 활용해 모든 값을 10씩 감소시키는 discount_all(d) 함수를 정의·호출하고,
# 결과를 키 사전순으로 정렬하여 key=value 형식의 쉼표 구분 문자열로 출력하는 문제입니다.
# ==============================================================
# ■ Algorithm
# 전역변수 prices의 값을 10씩 감소시키는 함수 작성 후 호출하여 딕셔너리는 함수 내에서 바꾸면 원본도 바뀌는 것을 확인
# ==============================================================

prices = {}
for t in input().split():
    k, v = t.split("=")
    prices[k] = int(v)

def discount_all(d):
    """
    전역변수 prices의 모든 값을 10씩 감소시키는 함수입니다

    Args:
        d(dict): 전역변수 prices
    Returns:
        None
    """
    # 딕셔너리는 가변객체이므로 함수 내에서 global 키워드 없이도 수정 가능
    for product in d:
        d[product] -= 10

discount_all(prices)

items = []
for k in sorted(prices):
    items.append(k + "=" + str(prices[k]))
print(",".join(items))

